<mah:MetroWindow x:Class="ProcessingApp.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Data Management" 
                 Height="650" Width="1100"
                 WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
          
            <RowDefinition Height="*"/>
     
            <RowDefinition Height="Auto"/>
          
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Параметры поиска" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal" Margin="5">

                <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}" 
                            mah:TextBoxHelper.Watermark="Выберите дату" 
                            Width="140" Margin="0,0,10,10"/>

                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                         mah:TextBoxHelper.Watermark="Фамилия" 
                         mah:TextBoxHelper.ClearTextButton="True" 
                         Width="130" Margin="0,0,10,10"/>

                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                         mah:TextBoxHelper.Watermark="Имя" 
                         mah:TextBoxHelper.ClearTextButton="True" 
                         Width="130" Margin="0,0,10,10"/>

                <TextBox Text="{Binding SurName, UpdateSourceTrigger=PropertyChanged}" 
                         mah:TextBoxHelper.Watermark="Отчество" 
                         mah:TextBoxHelper.ClearTextButton="True" 
                         Width="130" Margin="0,0,10,10"/>

                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" 
                         mah:TextBoxHelper.Watermark="Город" 
                         mah:TextBoxHelper.ClearTextButton="True" 
                         Width="130" Margin="0,0,10,10"/>

                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                         mah:TextBoxHelper.Watermark="Страна" 
                         mah:TextBoxHelper.ClearTextButton="True" 
                         Width="130" Margin="0,0,10,10"/>

                <Button Command="{Binding SearchCommand}" 
                        Content="Поиск" 
                        Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                        Width="100" Margin="0,0,0,10"
                        Cursor="Hand"/>
            </WrapPanel>
        </GroupBox>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Records}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True"
                  Style="{StaticResource MahApps.Styles.DataGrid}"
                  BorderThickness="1"
                  HeadersVisibility="Column">
           
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding SurName}" Width="*"/>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="*"/>
                <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Command="{Binding ImportCsvCommand}" 
                    Content="Импорт CSV..." 
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>

            <Button Command="{Binding ExportExcelCommand}" 
                    Content="Экспорт в Excel" 
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>

            <Button Command="{Binding ExportXmlCommand}" 
                    Content="Экспорт в XML" 
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>
        </StackPanel>

    </Grid>
</mah:MetroWindow>