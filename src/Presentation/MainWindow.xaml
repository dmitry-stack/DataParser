<mah:MetroWindow x:Class="ProcessingApp.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:ProcessingApp.Presentation.Localization"
                 Title="{Binding WindowTitle, Source={x:Static loc:Strings.Instance}}"
                 Height="650" Width="1100"
                 WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <Button Content="RU"
                        Command="{Binding SetLanguageCommand}"
                        CommandParameter="ru"
                        Width="40" Margin="0,0,5,0"
                        Style="{StaticResource MahApps.Styles.Button.Square}"/>
                <Button Content="EN"
                        Command="{Binding SetLanguageCommand}"
                        CommandParameter="en"
                        Width="40"
                        Style="{StaticResource MahApps.Styles.Button.Square}"/>
            </StackPanel>

            <GroupBox Header="{Binding SearchGroupHeader, Source={x:Static loc:Strings.Instance}}" Margin="0,0,0,15">
                <WrapPanel Orientation="Horizontal" Margin="5">

                    <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                mah:TextBoxHelper.Watermark="{Binding DateWatermark, Source={x:Static loc:Strings.Instance}}"
                                Width="140" Margin="0,0,10,10"/>

                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{Binding LastNameWatermark, Source={x:Static loc:Strings.Instance}}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Width="130" Margin="0,0,10,10"/>

                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{Binding FirstNameWatermark, Source={x:Static loc:Strings.Instance}}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Width="130" Margin="0,0,10,10"/>

                    <TextBox Text="{Binding SurName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{Binding SurNameWatermark, Source={x:Static loc:Strings.Instance}}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Width="130" Margin="0,0,10,10"/>

                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{Binding CityWatermark, Source={x:Static loc:Strings.Instance}}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Width="130" Margin="0,0,10,10"/>

                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="{Binding CountryWatermark, Source={x:Static loc:Strings.Instance}}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             Width="130" Margin="0,0,10,10"/>

                    <Button Command="{Binding SearchCommand}"
                            Content="{Binding SearchButton, Source={x:Static loc:Strings.Instance}}"
                            Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                            Width="100" Margin="0,0,0,10"
                            Cursor="Hand"/>
                </WrapPanel>
            </GroupBox>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Style="{StaticResource MahApps.Styles.DataGrid}"
                  BorderThickness="1"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding ColumnDate, Source={x:Static loc:Strings.Instance}}" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="{Binding ColumnLastName, Source={x:Static loc:Strings.Instance}}" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="{Binding ColumnFirstName, Source={x:Static loc:Strings.Instance}}" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="{Binding ColumnSurName, Source={x:Static loc:Strings.Instance}}" Binding="{Binding SurName}" Width="*"/>
                <DataGridTextColumn Header="{Binding ColumnCity, Source={x:Static loc:Strings.Instance}}" Binding="{Binding City}" Width="*"/>
                <DataGridTextColumn Header="{Binding ColumnCountry, Source={x:Static loc:Strings.Instance}}" Binding="{Binding Country}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Command="{Binding ImportCsvCommand}"
                    Content="{Binding ImportCsvButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>

            <Button Command="{Binding CancelImportCsvCommand}"
                     Content="{Binding CancelButton, Source={x:Static loc:Strings.Instance}}"
                     Style="{StaticResource MahApps.Styles.Button.Square}"
                      Width="100" Margin="10,0,0,0"
                      Foreground="Red"/>

            <Button Command="{Binding ExportExcelCommand}"
                    Content="{Binding ExportExcelButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>

            <Button Command="{Binding ExportXmlCommand}"
                    Content="{Binding ExportXmlButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="130" Margin="10,0,0,0"
                    Cursor="Hand"/>
        </StackPanel>

    </Grid>
</mah:MetroWindow>
