<mah:MetroWindow x:Class="ProcessingApp.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:loc="clr-namespace:ProcessingApp.Presentation.Localization"
                 xmlns:nav="clr-namespace:ProcessingApp.Presentation.Navigation"
                 xmlns:vm="clr-namespace:ProcessingApp.Presentation.ViewModels"
                 xmlns:views="clr-namespace:ProcessingApp.Presentation.Views"
                 Title="{Binding WindowTitle, Source={x:Static loc:Strings.Instance}}"
                 Width="1100"
                 Height="650"
                 MinWidth="900"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <!-- ViewModel-first навигация: тип ViewModel определяет, какой View показать. -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0"
                   Background="{DynamicResource MahApps.Brushes.Gray10}">

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,15">
                <Button Content="RU"
                        Command="{Binding SetLanguageCommand}"
                        CommandParameter="ru"
                        Width="50"
                        Margin="0,0,5,0"
                        Style="{StaticResource MahApps.Styles.Button.Square}" />
                <Button Content="EN"
                        Command="{Binding SetLanguageCommand}"
                        CommandParameter="en"
                        Width="50"
                        Style="{StaticResource MahApps.Styles.Button.Square}" />
            </StackPanel>

            <ListBox SelectedValuePath="Tag"
                     SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,15,0,0">
                <ListBoxItem Tag="{x:Static nav:AppPage.Search}"
                             IsSelected="True"
                             Content="{Binding NavSearch, Source={x:Static loc:Strings.Instance}}"
                             Padding="20,14"
                             FontSize="15" />
                <ListBoxItem Tag="{x:Static nav:AppPage.Import}"
                             Content="{Binding NavImport, Source={x:Static loc:Strings.Instance}}"
                             Padding="20,14"
                             FontSize="15" />
                <ListBoxItem Tag="{x:Static nav:AppPage.Export}"
                             Content="{Binding NavExport, Source={x:Static loc:Strings.Instance}}"
                             Padding="20,14"
                             FontSize="15" />
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</mah:MetroWindow>
