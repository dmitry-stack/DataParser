<UserControl x:Class="ProcessingApp.Presentation.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProcessingApp.Presentation.Localization">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Margin="25" MaxWidth="720" HorizontalAlignment="Left">

        <TextBlock Text="{Binding ExportPageTitle, Source={x:Static loc:Strings.Instance}}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBlock Text="{Binding ExportPageDescription, Source={x:Static loc:Strings.Instance}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,25" />

        <GroupBox Header="{Binding ExportFiltersHeader, Source={x:Static loc:Strings.Instance}}"
                  Margin="0,0,0,25">
            <TextBlock Text="{Binding FilterSummary}"
                       TextWrapping="Wrap"
                       Margin="5" />
        </GroupBox>

        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding ExportCommand}"
                    CommandParameter=".xlsx"
                    Content="{Binding ExportExcelButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Width="160"
                    Cursor="Hand" />

            <Button Command="{Binding ExportCommand}"
                    CommandParameter=".xml"
                    Content="{Binding ExportXmlButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Width="160"
                    Margin="10,0,0,0"
                    Cursor="Hand" />

            <Button Command="{Binding ExportCancelCommand}"
                    Content="{Binding CancelButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="100"
                    Margin="10,0,0,0"
                    Foreground="Red"
                    Cursor="Hand" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True"
                     Height="6"
                     Margin="0,25,0,0"
                     Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
