<UserControl x:Class="ProcessingApp.Presentation.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:ProcessingApp.Presentation.Localization">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Margin="25" MaxWidth="720" HorizontalAlignment="Left">

        <TextBlock Text="{Binding ImportPageTitle, Source={x:Static loc:Strings.Instance}}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBlock Text="{Binding ImportPageDescription, Source={x:Static loc:Strings.Instance}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,25" />

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SelectedFilePath, Mode=OneWay}"
                     IsReadOnly="True"
                     mah:TextBoxHelper.Watermark="{Binding FilePathWatermark, Source={x:Static loc:Strings.Instance}}" />

            <Button Grid.Column="1"
                    Command="{Binding BrowseFileCommand}"
                    Content="{Binding BrowseButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="150"
                    Margin="10,0,0,0"
                    Cursor="Hand" />
        </Grid>

        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding ImportCsvCommand}"
                    Content="{Binding ImportStartButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Width="150"
                    Cursor="Hand" />

            <Button Command="{Binding ImportCsvCancelCommand}"
                    Content="{Binding CancelButton, Source={x:Static loc:Strings.Instance}}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="100"
                    Margin="10,0,0,0"
                    Foreground="Red"
                    Cursor="Hand" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True"
                     Height="6"
                     Margin="0,25,0,0"
                     Visibility="{Binding ImportCsvCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
