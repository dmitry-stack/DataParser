<UserControl x:Class="ProcessingApp.Presentation.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:loc="clr-namespace:ProcessingApp.Presentation.Localization">

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ExecuteNewSearchCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding SearchPageTitle, Source={x:Static loc:Strings.Instance}}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15" />

        <GroupBox Grid.Row="1"
                  Header="{Binding SearchGroupHeader, Source={x:Static loc:Strings.Instance}}"
                  Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal" Margin="5">

                <DatePicker SelectedDate="{Binding Filter.Date, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="{Binding DateWatermark, Source={x:Static loc:Strings.Instance}}"
                            Width="140"
                            Margin="0,0,10,10" />

                <TextBox Text="{Binding Filter.LastName, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{Binding LastNameWatermark, Source={x:Static loc:Strings.Instance}}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Width="130"
                         Margin="0,0,10,10" />

                <TextBox Text="{Binding Filter.FirstName, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{Binding FirstNameWatermark, Source={x:Static loc:Strings.Instance}}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Width="130"
                         Margin="0,0,10,10" />

                <TextBox Text="{Binding Filter.SurName, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{Binding SurNameWatermark, Source={x:Static loc:Strings.Instance}}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Width="130"
                         Margin="0,0,10,10" />

                <TextBox Text="{Binding Filter.City, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{Binding CityWatermark, Source={x:Static loc:Strings.Instance}}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Width="130"
                         Margin="0,0,10,10" />

                <TextBox Text="{Binding Filter.Country, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{Binding CountryWatermark, Source={x:Static loc:Strings.Instance}}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         Width="130"
                         Margin="0,0,10,10" />

                <Button Command="{Binding ExecuteNewSearchCommand}"
                        Content="{Binding SearchButton, Source={x:Static loc:Strings.Instance}}"
                        Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                        Width="100"
                        Margin="0,0,10,10"
                        Cursor="Hand" />

                <Button Command="{Binding ClearFilterCommand}"
                        Content="{Binding ClearButton, Source={x:Static loc:Strings.Instance}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="100"
                        Margin="0,0,0,10"
                        Cursor="Hand" />
            </WrapPanel>
        </GroupBox>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Style="{StaticResource MahApps.Styles.DataGrid}"
                  BorderThickness="1"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding ColumnDate, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="100" />
                <DataGridTextColumn Header="{Binding ColumnLastName, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding LastName}"
                                    Width="*" />
                <DataGridTextColumn Header="{Binding ColumnFirstName, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding FirstName}"
                                    Width="*" />
                <DataGridTextColumn Header="{Binding ColumnSurName, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding SurName}"
                                    Width="*" />
                <DataGridTextColumn Header="{Binding ColumnCity, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding City}"
                                    Width="*" />
                <DataGridTextColumn Header="{Binding ColumnCountry, Source={x:Static loc:Strings.Instance}}"
                                    Binding="{Binding Country}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button Content="{Binding PreviousPageButton, Source={x:Static loc:Strings.Instance}}"
                    Command="{Binding PreviousPageCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="100" />

            <TextBlock Text="{Binding CurrentPageDisplay}"
                       VerticalAlignment="Center"
                       MinWidth="110"
                       TextAlignment="Center"
                       Margin="10,0" />

            <Button Content="{Binding NextPageButton, Source={x:Static loc:Strings.Instance}}"
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Width="100" />
        </StackPanel>
    </Grid>
</UserControl>
